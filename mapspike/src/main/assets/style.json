{
  "version": 8,
  "name": "PMM bodega de piso",
  "glyphs": "{GLYPHS_URL}",
  "light": { "anchor": "viewport", "color": "#ffffff", "intensity": 0.5, "position": [1.25, 205, 38] },
  "sources": {
    "zones":    { "type": "geojson", "data": { "type": "FeatureCollection", "features": [] }, "promoteId": "code" },
    "slots":    { "type": "geojson", "data": { "type": "FeatureCollection", "features": [] } },
    "walls":    { "type": "geojson", "data": { "type": "FeatureCollection", "features": [] } },
    "units":    { "type": "geojson", "data": { "type": "FeatureCollection", "features": [] }, "tolerance": 0, "maxzoom": 22, "buffer": 32 },
    "aisles":   { "type": "geojson", "data": { "type": "FeatureCollection", "features": [] } },
    "labels":   { "type": "geojson", "data": { "type": "FeatureCollection", "features": [] } },
    "route":    { "type": "geojson", "data": { "type": "FeatureCollection", "features": [] } },
    "routeDot": { "type": "geojson", "data": { "type": "FeatureCollection", "features": [] } },
    "you":      { "type": "geojson", "data": { "type": "FeatureCollection", "features": [] } }
  },
  "layers": [
    { "id": "bg", "type": "background", "paint": { "background-color": "#E7EDF5" } },

    { "id": "yard-fill", "type": "fill", "source": "zones",
      "filter": ["==", ["get", "kind"], "yard"],
      "paint": { "fill-color": "#D9E1EC" } },
    { "id": "floor-fill", "type": "fill", "source": "zones",
      "filter": ["==", ["get", "kind"], "floor"],
      "paint": { "fill-color": "#FBFCFE" } },
    { "id": "zone-fill", "type": "fill", "source": "zones",
      "filter": ["match", ["get", "kind"], ["dock", "pallets", "ibc", "crates", "tubes", "lots", "office"], true, false],
      "paint": { "fill-color": ["match", ["get", "kind"],
        "dock", "#FDF2D9", "pallets", "#EEF3FB", "ibc", "#E6F4F1", "crates", "#F7F0E6",
        "tubes", "#EDEFF3", "lots", "#F1EAF8", "office", "#FFFFFF", "#F1F5FA"] } },
    { "id": "zone-line", "type": "line", "source": "zones",
      "filter": ["match", ["get", "kind"], ["dock", "pallets", "ibc", "crates", "tubes", "lots", "office"], true, false],
      "paint": { "line-color": "#BFCADB", "line-width": 1 } },
    { "id": "slots-line", "type": "line", "source": "slots", "minzoom": 19,
      "paint": { "line-color": "#C9D4E4", "line-width": 0.8 } },
    { "id": "aisle-guides", "type": "line", "source": "aisles", "minzoom": 19.2,
      "paint": { "line-color": "#CFD8E6", "line-width": 1.2, "line-dasharray": [3, 3] } },

    { "id": "walls", "type": "fill-extrusion", "source": "walls",
      "paint": { "fill-extrusion-color": "#9AA9BF", "fill-extrusion-height": ["get", "h"], "fill-extrusion-base": 0 } },
    { "id": "units", "type": "fill-extrusion", "source": "units",
      "paint": { "fill-extrusion-color": ["get", "color"], "fill-extrusion-height": ["get", "top"], "fill-extrusion-base": ["get", "base"] } },

    { "id": "route-casing", "type": "line", "source": "route",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#FFFFFF", "line-width": ["interpolate", ["linear"], ["zoom"], 18, 6, 20, 13, 22.5, 26] } },
    { "id": "route-line", "type": "line", "source": "route",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#2563EB", "line-width": ["interpolate", ["linear"], ["zoom"], 18, 4, 20, 8, 22.5, 16] } },
    { "id": "route-chev", "type": "symbol", "source": "route",
      "layout": { "symbol-placement": "line", "symbol-spacing": 46, "icon-image": "chev",
        "icon-size": ["interpolate", ["linear"], ["zoom"], 18, 0.34, 20, 0.6, 22.5, 1.1],
        "icon-allow-overlap": true, "icon-ignore-placement": true },
      "paint": { "icon-color": "#FFFFFF" } },

    { "id": "sel-halo", "type": "line", "source": "zones",
      "filter": ["==", ["get", "code"], ""],
      "paint": { "line-color": "#FACC15", "line-width": 4, "line-opacity": 0.9, "line-blur": 1 } },
    { "id": "you-ring", "type": "circle", "source": "you",
      "paint": { "circle-radius": 24, "circle-color": "#2563EB", "circle-opacity": 0.16, "circle-pitch-alignment": "map" } },
    { "id": "you-dot", "type": "circle", "source": "you",
      "paint": { "circle-radius": 8, "circle-color": "#2563EB", "circle-stroke-color": "#FFFFFF", "circle-stroke-width": 3, "circle-pitch-alignment": "map" } },
    { "id": "route-dot", "type": "circle", "source": "routeDot",
      "paint": { "circle-radius": 6, "circle-color": "#FFFFFF", "circle-stroke-color": "#2563EB", "circle-stroke-width": 3, "circle-pitch-alignment": "map" } },

    { "id": "lbl-zone", "type": "symbol", "source": "labels",
      "filter": ["==", ["get", "kind"], "zone"],
      "layout": { "text-field": ["get", "code"], "text-font": ["NotoSans-Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 18, 11, 21, 20], "text-letter-spacing": 0.15,
        "text-pitch-alignment": "viewport", "text-rotation-alignment": "viewport" },
      "paint": { "text-color": "#64748B", "text-halo-color": "#FFFFFF", "text-halo-width": 1.6 } },
    { "id": "lbl-unit", "type": "symbol", "source": "labels", "minzoom": 19.8,
      "filter": ["==", ["get", "kind"], "unit"],
      "layout": { "text-field": ["get", "code"], "text-font": ["NotoSans-Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 19.8, 9, 22, 15], "text-allow-overlap": false,
        "text-pitch-alignment": "viewport", "text-rotation-alignment": "viewport" },
      "paint": { "text-color": "#334155", "text-halo-color": "#FFFFFF", "text-halo-width": 1.5 } }
  ]
}
