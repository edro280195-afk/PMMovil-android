<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Sólo debug puede comunicarse con el API local sin TLS. -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- adb reverse tcp:5000 tcp:5000 conecta el Pixel por USB al API de la laptop. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">192.168.10.29</domain>
        <domain includeSubdomains="false">192.168.10.193</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
